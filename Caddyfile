{
    admin off
}

# infhub.org — primary site
infhub.org {
    reverse_proxy web:3000
}

# www.infhub.org — www variant
www.infhub.org {
    reverse_proxy web:3000
}

# infcraft.infhub.org — INFCRAFT subdomain
infcraft.infhub.org {
    rewrite / /infcraft
    reverse_proxy web:3000
}

# www.infcraft.infhub.org — www variant
www.infcraft.infhub.org {
    rewrite / /infcraft
    reverse_proxy web:3000
}

# cjwijz.infhub.org — CJWIJZ subdomain
cjwijz.infhub.org {
    rewrite / /cjwijz
    reverse_proxy web:3000
}
