# ============================================================
# INFHUB Environment Configuration
# ============================================================
# Copy this file to .env and update the values below.
#   cp .env.example .env
#
# IMPORTANT: Use strong, unique passwords in production!
# ============================================================

# MariaDB root password (used for healthcheck and admin access)
DB_ROOT_PASSWORD=change_me_to_a_strong_password

# MariaDB application user password (used by the app)
DB_PASSWORD=change_me_to_a_strong_password

# The Lounge IRC client configuration
LOUNGE_HOST=irc.infhub.org
LOUNGE_PORT=443

# Session secret (used for session/JWT signing)
SESSION_SECRET=change_me_to_a_strong_secret

# Next.js public URL
NEXT_PUBLIC_URL=http://localhost:3000
